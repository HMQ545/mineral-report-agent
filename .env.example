# Copy this file to `.env` and fill in your own key. `.env` is git-ignored.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: override where reports are written (defaults to <project>/reports)
# MINEREPORT_REPORTS_DIR=

# Optional: connect the agent to already-running Streamable HTTP MCP servers.
# When unset the agent launches the servers itself over stdio.
# MINEREPORT_NEWS_URL=http://127.0.0.1:8101/mcp
# MINEREPORT_PDF_URL=http://127.0.0.1:8102/mcp
# MINEREPORT_PRICE_URL=http://127.0.0.1:8103/mcp
# MINEREPORT_PDF_ALLOWED_HOSTS=minedocs.com,lithiumionic.com,*.liontown.com

# Optional, and NOT to be put in this file: when the host reaches the internet
# through a local proxy, containers need the same proxy. Put the three lines
# below in `docker.env` (read only by docker compose) - never in `.env`, because
# the local agent also loads `.env` and would then fail to reach the internet.
# HTTP_PROXY=http://host.docker.internal:7899
# HTTPS_PROXY=http://host.docker.internal:7899
# NO_PROXY=localhost,127.0.0.1,mining-news-mcp,mineral-pdf-mcp,lme-price-mcp,agent